---
import { getImage } from 'astro:assets';
import van from '@/assets/cross-pro-services-van.jpg';

interface Props {
  sizes: string;
  priority?: boolean;
  deferred?: boolean;
  alt?: string;
}
const {
  sizes,
  priority = false,
  deferred = false,
  alt = 'Cross Pro Services work van with the company logo, parked in front of homes',
} = Astro.props;
const widths = [480, 768, 1280, van.width];
const variants = await Promise.all(
  ['webp', 'jpg'].map(async (format) => {
    const images = await Promise.all(
      widths.map((width) => getImage({ src: van, width, format, quality: 78 })),
    );
    return {
      srcset: images
        .map((image, index) => `${image.src} ${widths[index]}w`)
        .join(', '),
      fallback: images.at(-1)!.src,
    };
  }),
);
const [webp, jpeg] = variants;
---

<picture data-company-photo="van">
  <source
    type="image/webp"
    srcset={deferred ? undefined : webp!.srcset}
    data-srcset={deferred ? webp!.srcset : undefined}
    sizes={sizes}
  />
  <img
    src={deferred ? undefined : jpeg!.fallback}
    data-src={deferred ? jpeg!.fallback : undefined}
    srcset={deferred ? undefined : jpeg!.srcset}
    data-srcset={deferred ? jpeg!.srcset : undefined}
    sizes={sizes}
    width={van.width}
    height={van.height}
    alt={alt}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding="async"
  />
</picture>
