---
import { smsHref } from '@/config/site';
---

<a
  class="sms-button"
  href={smsHref}
  aria-label="Text Cross Pro Services via SMS"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="28"
    height="28"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5H3l1.8-4.2A8.5 8.5 0 1 1 21 11.5Z"></path>
    <path d="M8 10h8M8 14h5"></path>
  </svg>
  <span>Text us</span>
</a>

<style>
  .sms-button {
    position: fixed;
    right: calc(1.25rem + env(safe-area-inset-right, 0px));
    bottom: calc(1.25rem + env(safe-area-inset-bottom, 0px));
    z-index: 40;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    min-width: 3.5rem;
    min-height: 3.5rem;
    padding: 0.85rem 1.15rem;
    border: 1px solid #ffffff40;
    border-radius: 999px;
    background: #146c46;
    color: #fff;
    box-shadow: 0 4px 20px #0003;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    clip-path: inset(-24px round 999px);
    transition: clip-path 0.45s ease-in-out;
  }

  .sms-button:hover {
    background: #105637;
  }

  .sms-button:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 4px;
  }

  .sms-button svg {
    flex-shrink: 0;
    transition: transform 0.45s ease-in-out;
  }

  .sms-button span {
    transition: opacity 0.25s ease-out;
  }

  .sms-button.is-collapsing {
    clip-path: inset(0 0 0 var(--collapse-distance) round 999px);
  }

  .sms-button.is-collapsing svg {
    transform: translateX(var(--icon-shift));
  }

  .sms-button.is-collapsing span {
    opacity: 0;
  }

  .sms-button.is-compact {
    transition: none;
    width: 3.5rem;
    height: 3.5rem;
    padding: 0;
    gap: 0;
  }

  .sms-button.is-compact svg {
    transition: none;
  }

  .sms-button.is-compact span {
    display: none;
  }
</style>
