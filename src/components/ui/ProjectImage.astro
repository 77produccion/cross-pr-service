---
import type { HTMLAttributes } from 'astro/types';
import projectPhotos from '@/data/photos.json';
import exteriorPhotos from '@/data/exterior.json';

interface Props {
  id: string;
  /** Required: describe the actual layout width, not the device name. */
  sizes: string;
  alt?: string;
  priority?: boolean;
  /** Secondary hero frames are hydrated one at a time. */
  deferred?: boolean;
  class?: HTMLAttributes<'picture'>['class'];
}

const {
  id,
  sizes,
  alt,
  priority = false,
  deferred = false,
  class: className,
} = Astro.props;
const photo = [...projectPhotos, ...exteriorPhotos].find(
  (image) => image.id === id,
);
if (!photo) throw new Error(`Unknown photo ID: ${id}`);
const webp = photo.variants.filter((variant) => variant.format === 'webp');
const avif = photo.variants.filter((variant) => variant.format === 'avif');
const jpeg = photo.variants.filter((variant) => variant.format === 'jpeg');
const fallback = jpeg.at(-1)!;
const srcset = (variants: typeof photo.variants) =>
  variants.map((variant) => `${variant.src} ${variant.width}w`).join(', ');
---

<picture class={className} data-photo-id={id}>
  {avif.length > 0 && (
    <source
      type="image/avif"
      srcset={deferred ? undefined : srcset(avif)}
      data-srcset={deferred ? srcset(avif) : undefined}
      sizes={sizes}
    />
  )}
  <source
    type="image/webp"
    srcset={deferred ? undefined : srcset(webp)}
    data-srcset={deferred ? srcset(webp) : undefined}
    sizes={sizes}
  />
  <img
    src={deferred ? undefined : fallback.src}
    data-src={deferred ? fallback.src : undefined}
    srcset={deferred ? undefined : srcset(jpeg)}
    data-srcset={deferred ? srcset(jpeg) : undefined}
    sizes={sizes}
    width={photo.width}
    height={photo.height}
    alt={alt ?? photo.alt}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding="async"
  />
</picture>

<style>
  picture {
    display: block;
  }
  img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
