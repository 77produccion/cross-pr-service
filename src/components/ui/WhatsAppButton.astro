---
import { whatsappHref } from '@/config/site';
---

<a
  class="whatsapp-button"
  href={whatsappHref}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat with Cross Pro Services on WhatsApp (opens in a new tab)"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="28"
    height="28"
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M20.52 3.48A11.9 11.9 0 0 0 12.05 0C5.46 0 .1 5.36.1 11.95c0 2.1.55 4.16 1.6 5.98L0 24l6.23-1.63a11.94 11.94 0 0 0 5.82 1.48h.01C18.64 23.85 24 18.49 24 11.9c0-3.19-1.24-6.18-3.48-8.42ZM12.06 21.83a9.9 9.9 0 0 1-5.04-1.38l-.36-.21-3.7.97.99-3.61-.24-.37a9.9 9.9 0 0 1-1.52-5.28c0-5.48 4.46-9.94 9.94-9.94a9.87 9.87 0 0 1 7.03 2.92 9.87 9.87 0 0 1 2.91 7.03c0 5.48-4.46 9.87-10.01 9.87Zm5.45-7.44c-.3-.15-1.77-.87-2.04-.97-.28-.1-.48-.15-.68.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.49 0 1.47 1.07 2.89 1.22 3.09.15.2 2.1 3.2 5.09 4.49.71.31 1.27.5 1.7.63.71.23 1.36.2 1.87.12.57-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35Z"></path>
  </svg>
  <span>Chat on WhatsApp</span>
</a>

<style>
  .whatsapp-button {
    position: fixed;
    right: calc(1.25rem + env(safe-area-inset-right, 0px));
    bottom: calc(1.25rem + env(safe-area-inset-bottom, 0px));
    z-index: 40;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    min-width: 3.5rem;
    min-height: 3.5rem;
    padding: 0.85rem 1.15rem;
    border: 1px solid #ffffff40;
    border-radius: 999px;
    background: #146c46;
    color: #fff;
    box-shadow: 0 4px 20px #0003;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
  }

  .whatsapp-button:hover {
    background: #105637;
  }

  .whatsapp-button:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 4px;
  }

  .whatsapp-button svg {
    flex-shrink: 0;
  }

  @media (max-width: 40rem) {
    .whatsapp-button {
      padding: 0.85rem;
    }

    .whatsapp-button span {
      display: none;
    }
  }
</style>
