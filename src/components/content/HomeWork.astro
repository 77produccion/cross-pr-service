---
import ProjectImage from '@/components/ui/ProjectImage.astro';
import { projects } from '@/config/projects';
import ProjectLightbox from './ProjectLightbox.astro';
const visible = projects.slice(0, 5);
---

<section class="home-work" id="work" data-gallery data-project-carousel>
  <div class="container">
    <div class="section-heading" data-reveal>
      <div>
        <p class="overline dark">Our work</p>
        <h2>Recent projects.</h2>
        <p class="lead">
          A selection of painting and remodeling work across Central Texas.
        </p>
      </div>
      <div class="carousel-controls" hidden>
        <button
          type="button"
          data-carousel-prev
          aria-label="Previous projects"
          aria-controls="project-track"
        >
          ←
        </button>
        <button
          type="button"
          data-carousel-next
          aria-label="Next projects"
          aria-controls="project-track"
        >
          →
        </button>
      </div>
    </div>
    <div
      class="project-track"
      id="project-track"
      tabindex="0"
      role="region"
      aria-label="Recent projects"
      data-project-track
    >
      {visible.map((project) => (
        <figure class="home-project">
          <a
            class="image-frame"
            data-photo-motion
            href={`/our-work/#${project.id}`}
            data-project-image
            data-project={project.id}
            aria-label={`View ${project.title} in Our Work`}
          >
            <ProjectImage
              id={project.image}
              alt={project.alt}
              sizes="(max-width: 760px) 82vw, 420px"
            />
          </a>
          <figcaption>
            <small>{project.category}</small>
            <b>{project.title}</b>
          </figcaption>
        </figure>
      ))}
    </div>
    <div class="section-more" data-reveal>
      <a class="button button-outline" href="/our-work/">
        View all projects <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
  <ProjectLightbox projects={visible} />
</section>
