---
import { site, whatsappHref } from '@/config/site';
import EstimateForm from './EstimateForm.astro';
---

<div class="contact-grid">
  <aside class="contact-aside">
    <p class="overline">Project details</p>
    <h2>
      Let’s talk about <em>your space.</em>
    </h2>
    <div class="contact-coverage">
      <span class="small-label">Service area</span>
      <p>Austin</p>
      <p>San Antonio</p>
      <small>&amp; surrounding communities</small>
    </div>
    <div class="contact-note">
      <strong>Contact our team</strong>
      <p>WhatsApp: {site.whatsapp.displayNumber}</p>
      <a
        class="text-link"
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
      >
        Chat on WhatsApp <span class="sr-only">(opens in a new tab)</span>
      </a>
    </div>
  </aside>
  <EstimateForm id="contact-estimate" />
</div>
