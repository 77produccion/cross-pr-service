---
import ProjectImage from '@/components/ui/ProjectImage.astro';
import { projects } from '@/config/projects';
import ProjectLightbox from './ProjectLightbox.astro';
import { getPhotoSource } from '@/utils/photos';
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
const visible = compact ? projects.slice(0, 3) : projects;
---

<div data-gallery>
  {!compact && (
    <div class="gallery-filters" aria-label="Filter project photos" hidden>
      {['All', 'Interiors', 'Exteriors', 'Cabinets'].map((category) => (
        <button
          type="button"
          data-filter={category}
          aria-pressed={category === 'All'}
        >
          {category}
        </button>
      ))}
    </div>
  )}
  <div class="project-grid">
    {visible.map((project) => (
      <figure
        id={project.id}
        class="project-card"
        data-category={project.category}
        data-reveal
      >
        <a
          class="image-frame"
          href={getPhotoSource(project.image)}
          data-project-image
          data-project={project.id}
          aria-label={`Enlarge: ${project.title}`}
        >
          <ProjectImage
            id={project.image}
            alt={project.alt}
            sizes="(max-width: 650px) calc(100vw - 2.4rem), (max-width: 1600px) 29vw, 440px"
          />
        </a>
        <figcaption>
          <h3>{project.title}</h3>
          <span>{project.category}</span>
          <p class="project-description">{project.description}</p>
          <span class="project-photo-count">
            {project.images.length}{' '}
            {project.images.length === 1 ? 'photo' : 'photos'}
          </span>
        </figcaption>
        <noscript>
          <ul>
            {project.images.map((id, index) => (
              <li>
                <a href={getPhotoSource(id)}>View photo {index + 1}</a>
              </li>
            ))}
          </ul>
        </noscript>
      </figure>
    ))}
  </div>
  <p class="gallery-status" aria-live="polite">
    {visible.length} projects
  </p>
  <ProjectLightbox projects={visible} />
</div>
