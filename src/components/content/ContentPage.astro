---
import { getEntry, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import Home from './Home.astro';
import FinalCTA from './FinalCTA.astro';
import PageIntro from './PageIntro.astro';
import { site } from '@/config/site';
import { ctaPhotos } from '@/config/projects';
import { pageIntros } from '@/config/presentation';

interface Props {
  id: string;
}
const entry = await getEntry('pages', Astro.props.id);
if (!entry) throw new Error(`Missing page content: ${Astro.props.id}`);
const { Content } = await render(entry);
const ctaImage = ctaPhotos[Astro.props.id];
const intro = pageIntros[Astro.props.id];
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  page={Astro.props.id}
>
  {Astro.props.id === 'home' ? (
    <Home>
      <Content />
    </Home>
  ) : (
    <div class={`page-content page-${Astro.props.id}`}>
      <PageIntro
        heading={entry.data.heading}
        image={intro!.image}
        accent={intro!.accent}
        summary={intro!.summary}
        label={
          site.navigation.find((item) => item.href === Astro.url.pathname)
            ?.label ?? entry.data.title
        }
      />
      <Container class="page-body">
        <div class="prose">
          <Content />
        </div>
        {ctaImage && <FinalCTA image={ctaImage} />}
      </Container>
    </div>
  )}
</BaseLayout>
