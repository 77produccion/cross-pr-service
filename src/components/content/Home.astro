---
import ProjectImage from '@/components/ui/ProjectImage.astro';
import Action from '@/components/ui/Action.astro';
import HomeServices from './HomeServices.astro';
import HomeWork from './HomeWork.astro';
import FinalCTA from './FinalCTA.astro';
import ProjectShowcase from './ProjectShowcase.astro';
import { interiorDetails, ctaPhotos } from '@/config/projects';
const heroPhotos = [
  'cps-007',
  'cps-024',
  'cps-022',
  'cps-017',
  'cps-042',
  'cps-002',
];
---

<section class="hero-c">
  <div class="hero-c-media image-frame">
    {heroPhotos.map((id, index) => (
      <div
        class:list={['hero-c-slide', { 'is-first': index === 0 }]}
        data-hero-slide
        aria-hidden={index !== 0 ? 'true' : undefined}
      >
        <ProjectImage
          id={id}
          sizes="(max-width: 900px) 100vw, 65vw"
          priority={index === 0}
        />
      </div>
    ))}
  </div>
  <div class="hero-c-panel">
    <h1>
      Painting <em>&amp;</em>
      <br />
      remodeling
      <span class="sr-only"> in Austin &amp; San Antonio</span>
    </h1>
    <p class="hero-c-lede">
      <slot />
    </p>
    <div class="hero-c-actions">
      <Action />
      <a class="hero-c-link" href="/our-work/">
        See our work
      </a>
    </div>
  </div>
</section>
<HomeServices />
<section class="about-c">
  <ProjectShowcase images={interiorDetails} id="home-interior-photo">
    <p class="kicker-c">About Cross Pro</p>
    <h2>Ten years of considered work.</h2>
    <p>
      With more than 10 years of experience, Cross Pro Services is committed to
      delivering professional results and work that exceeds our clients’
      expectations.
    </p>
    <ul class="about-c-list">
      <li>Residential &amp; commercial</li>
      <li>Painting &amp; remodeling</li>
      <li>Serving Central Texas</li>
    </ul>
    <Action href="/about-us/" label="More about us" secondary />
  </ProjectShowcase>
</section>
<HomeWork />
<section class="area-c">
  <div class="container area-c-grid">
    <p class="kicker-c area-c-label">Service area</p>
    <div class="area-c-content">
      <h2>
        Central Texas,
        <br />
        close to home.
      </h2>
      <p>
        Painting and remodeling for homes and businesses across the Austin and
        San Antonio metros.
      </p>
      <div class="area-c-links">
        <a href="/contact/">Austin</a>
        <a href="/contact/">San Antonio</a>
      </div>
      <p class="area-c-note">And surrounding communities.</p>
    </div>
  </div>
</section>
<div class="container">
  <FinalCTA image={ctaPhotos['home']!} />
</div>
