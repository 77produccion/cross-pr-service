---
import ProjectImage from '@/components/ui/ProjectImage.astro';
import CompanyVanImage from '@/components/ui/CompanyVanImage.astro';
import HomeServices from './HomeServices.astro';
import HomeWork from './HomeWork.astro';
import EstimateForm from './EstimateForm.astro';
import BeforeAfter from './BeforeAfter.astro';
import { heroPhotos } from '@/config/presentation';
---

<section class="hero" id="top">
  <div class="hero-media image-frame">
    {heroPhotos.map((photo, index) => (
      <div
        class:list={['hero-slide', { 'is-first': index === 0 }]}
        style={`--photo-position: ${photo.position}`}
        data-hero-slide
        aria-hidden={index > 0 ? 'true' : undefined}
      >
        <ProjectImage
          id={photo.id}
          sizes="100vw"
          priority={index === 0}
          deferred={index > 0}
          {...(index > 0 ? { alt: '' } : {})}
        />
      </div>
    ))}
  </div>
  <div class="container">
    <div class="hero-copy">
      <p class="overline">Painting &amp; Remodeling · Central Texas</p>
      <h1>
        Painting &amp; remodeling
        <br />
        in Austin &amp;
        <br />
        <em>San Antonio.</em>
      </h1>
      <div class="hero-text">
        <slot />
      </div>
      <div class="actions">
        <a href="#contact" class="button">
          Request an Estimate <span aria-hidden="true">→</span>
        </a>
        <a href="/our-work/" class="button button-secondary">
          See our work <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>
<HomeServices />
<BeforeAfter />
<section class="about" id="about">
  <div class="container about-grid">
    <div class="about-media image-frame" data-reveal data-photo-motion>
      <CompanyVanImage sizes="(max-width: 980px) 100vw, 560px" />
    </div>
    <div data-reveal>
      <p class="overline dark">About Cross Pro</p>
      <h2>
        More than a decade <em>of experience.</em>
      </h2>
      <p class="lead">
        Led by owner Maurilio Jiménez, Cross Pro Services brings over 10 years
        of experience in painting and remodeling for homes and businesses.
      </p>
      <a href="/about-us/" class="button button-outline">
        More about us <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
<HomeWork />
<section class="area" id="area">
  <div class="container area-grid">
    <div data-reveal>
      <p class="overline">Service area</p>
      <h2>
        Central Texas,
        <br />
        <em>close to home.</em>
      </h2>
      <p class="lead">
        Serving Austin, San Antonio and surrounding communities.
      </p>
    </div>
    <div class="cities" data-reveal>
      <a class="city" href="/contact/">
        <b>Austin</b>
        <span>Get a quote →</span>
      </a>
      <a class="city" href="/contact/">
        <b>San Antonio</b>
        <span>Get a quote →</span>
      </a>
    </div>
  </div>
</section>
<section class="estimate-section" id="contact">
  <div class="container estimate-grid">
    <div data-reveal>
      <p class="overline">Request an estimate</p>
      <h2>
        Ready to start
        <br />
        your <em>project?</em>
      </h2>
      <p class="lead">
        Share your project details and location. Our team will help you discuss
        the next steps.
      </p>
    </div>
    <EstimateForm />
  </div>
</section>
