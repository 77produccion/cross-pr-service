---
import ProjectImage from '@/components/ui/ProjectImage.astro';
import { services } from '@/config/projects';
const visible = [
  {
    ...services[0],
    description:
      'Interior painting for living spaces, bedrooms, kitchens and offices.',
  },
  {
    ...services[1],
    description: 'Refresh your property’s exterior with a new paint finish.',
  },
  {
    ...services[5],
    title: 'Remodeling',
    image: services[3].image,
    alt: services[3].alt,
    description:
      'Remodeling for homes and businesses. Contact us to discuss your project.',
  },
];
---

<section class="home-services" id="services">
  <div class="container">
    <div class="section-heading" data-reveal>
      <div>
        <p class="overline">What we do</p>
        <h2>
          Painting &amp; <em>remodeling.</em>
        </h2>
      </div>
      <p>
        Interior and exterior painting, drywall, cabinet projects and exterior
        wood repairs for residential and commercial properties.
      </p>
    </div>
    <div class="home-service-grid">
      {visible.map((service) => (
        <article class="home-service" data-reveal>
          <div class="image-frame" data-photo-motion>
            <ProjectImage
              id={service.image}
              alt={service.alt}
              sizes="(max-width: 980px) 100vw, 33vw"
            />
          </div>
          <div class="home-service-copy">
            <h3 class="home-service-title">{service.title}</h3>
            <p class="home-service-description">{service.description}</p>
            <a class="text-link" href={`/contact/?service=${service.id}`}>
              Request an estimate <span aria-hidden="true">→</span>
            </a>
          </div>
        </article>
      ))}
    </div>
    <div class="section-more" data-reveal>
      <a class="button button-secondary" href="/services/">
        View all services <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
