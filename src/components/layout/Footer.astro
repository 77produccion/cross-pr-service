---
import { site, whatsappHref } from '@/config/site';
import Container from '@/components/ui/Container.astro';
import { Image } from 'astro:assets';
import logo from '@/assets/logo.webp';
---

<footer class="site-footer">
  <Container>
    <div class="footer-grid">
      <div>
        <a class="footer-brand" href="/" aria-label={`${site.name} — Home`}>
          <Image src={logo} alt={site.name} width={180} loading="lazy" />
        </a>
        <p class="footer-description">
          Painting and remodeling in Austin, San Antonio and surrounding
          communities.
        </p>
      </div>
      <div>
        <h2>Navigate</h2>
        <ul class="footer-links">
          {site.navigation.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2>Contact</h2>
        <ul class="footer-links">
          <li>
            <a
              class="footer-whatsapp"
              href={whatsappHref}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Chat on WhatsApp: ${site.whatsapp.displayNumber} (opens in a new tab)`}
            >
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                aria-hidden="true"
              >
                <path d="M21 11.5a9 9 0 0 1-13.5 7.8L3 21l1.7-4.5A9 9 0 1 1 21 11.5Z"></path>
              </svg>
              <span>{site.whatsapp.displayNumber}</span>
            </a>
          </li>
          <li>
            <a href={whatsappHref} target="_blank" rel="noopener noreferrer">
              Open WhatsApp <span class="sr-only">(opens in a new tab)</span>
            </a>
          </li>
          <li>Austin, San Antonio &amp; surrounding communities</li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>
        © {new Date().getFullYear()} {site.name}
      </p>
      <p>Austin · San Antonio · Central Texas</p>
    </div>
  </Container>
</footer>

<style>
  .footer-whatsapp {
    gap: 0.65rem;
  }
  .footer-whatsapp svg {
    flex-shrink: 0;
  }
</style>
